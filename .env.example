# Backblaze B2 (required) — S3-compatible API, standardized B2_* names.
# The S3 endpoint is derived from B2_REGION as
# https://s3.<B2_REGION>.backblazeb2.com — set the region, not a full URL.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=us-west-004

# Optional: durable public base for a public bucket / CDN in front of B2.
# When set, pins render via durable public URLs (the egress/CDN showcase)
# instead of app-mediated presigned URLs. Leave empty for a private bucket.
B2_PUBLIC_URL_BASE=

# AI image generation (required for /generate) — OpenAI via Genblaze.
OPENAI_API_KEY=your_openai_api_key
# gpt-image-1 render quality: low | medium | high | auto.
MOODBOARD_IMAGE_QUALITY=medium

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001AbCdEfGhIjKlMnOpQrStUvWxYz0=
# B2_BUCKET_NAME=my-moodboards
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-moodboards.s3.us-west-004.backblazeb2.com
